# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).

# Token do Bot do Telegram — obtenha conversando com @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID para onde os alertas serão enviados — obtenha com @userinfobot
# (ou enviando uma mensagem ao seu bot e consultando o endpoint getUpdates)
TELEGRAM_CHAT_ID=

# Exchange (Binance pública — endpoints somente leitura, não requer chave de API)
EXCHANGE_BASE_URL=https://api.binance.com
SYMBOL=BTCBRL

# Banco de dados SQLite (caminho do arquivo)
# No Docker o docker-compose.yml já sobrescreve para /app/data/btc_bot.db
DB_PATH=btc_bot.db

# Fuso horário local (usado só para a pergunta do orçamento diário)
FUSO_HORARIO_LOCAL=America/Boa_Vista

# Timing
CHECK_INTERVAL_SECONDS=300
RETENCAO_HISTORICO_HORAS=24

# Indicadores técnicos
RSI_PERIOD=14
RSI_OVERSOLD_THRESHOLD=30.0
MA_FAST_JANELA_PONTOS=3

# Regras de negócio
QUEDA_MINIMA_PERCENTUAL=1.0
META_LUCRO_PERCENTUAL=5.0
STOP_LOSS_PERCENTUAL=8.0
ALERTA_COOLDOWN_MINUTOS=60
