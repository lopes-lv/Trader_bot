[Unit]
Description=Bot de Monitoramento de BTC via Telegram
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=btcbot
WorkingDirectory=/opt/btc_alert_bot
# Atenção: valores do EnvironmentFile sobrescrevem Environment=. O instalar.sh
# garante que o .env instalado aponte DB_PATH para o caminho nativo.
EnvironmentFile=/opt/btc_alert_bot/.env
Environment=DB_PATH=/opt/btc_alert_bot/data/btc_bot.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/btc_alert_bot/venv/bin/python /opt/btc_alert_bot/src/main.py
Restart=always
RestartSec=10

# Limites de recursos (hardware limitado)
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
